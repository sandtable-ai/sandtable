{
  "name": "sandtable-ai",
  "version": "0.1.0-alpha.0",
  "description": "Rehearse your AI agent on a simulated copy of your customer's world before it goes live: tau-bench-style simulations with stateful tools, policy invariants and pass^k.",
  "license": "MIT",
  "homepage": "https://github.com/sandtable-ai/sandtable#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandtable-ai/sandtable.git"
  },
  "bugs": "https://github.com/sandtable-ai/sandtable/issues",
  "type": "module",
  "bin": {
    "sandtable": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples/freight",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sandtable": "node src/cli.ts",
    "demo": "node src/cli.ts demo",
    "version": "node scripts/sync-version.mjs && git add python plugin"
  },
  "keywords": [
    "sandtable",
    "ai-agents",
    "evals",
    "simulation",
    "tau-bench",
    "pass^k",
    "llm-testing",
    "agent-testing",
    "forward-deployed-engineering"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/bedrock-sdk": ">=0.35.0",
    "@aws-sdk/client-bedrock-runtime": ">=3.797.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/bedrock-sdk": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/credential-providers": "^3.1152.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
