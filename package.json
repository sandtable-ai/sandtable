{
  "name": "rehearse-agents",
  "version": "0.1.0-alpha.0",
  "description": "Rehearse your AI agent on a simulated copy of your customer's world before it goes live: tau-bench-style simulations with stateful tools, policy invariants and pass^k.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rehearse": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rehearse": "node src/cli.ts",
    "demo": "node src/cli.ts demo --offline"
  },
  "keywords": [
    "ai-agents",
    "evals",
    "simulation",
    "tau-bench",
    "pass^k",
    "llm-testing",
    "agent-testing",
    "forward-deployed-engineering"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
