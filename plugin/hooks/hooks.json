{
  "description": "Installs sandtable-ai only into the working folder's own npm project.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/install-in-own-project.mjs"], "timeout": 10 }]
      }
    ]
  }
}
